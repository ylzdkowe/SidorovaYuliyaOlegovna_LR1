<Page x:Class="MyNotesApp.Views.CalcPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MyNotesApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CalcPage">

    <StackPanel Margin="20">
        <TextBlock Text="Число 1:"/>
        <TextBox x:Name="TxtNum1" Margin="0,0,0,10"/>

        <TextBlock Text="Число 2:"/>
        <TextBox x:Name="TxtNum2" Margin="0,0,0,10"/>

        <Button x:Name="BtnCalc" Content="Сложить" Click="BtnCalc_Click" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtResult" Text="Результат: " FontSize="16"/>
    </StackPanel>
</Page>
