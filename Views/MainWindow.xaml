<Window x:Class="MyNotesApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyNotesApp" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#EEEEEE">
            <Button x:Name="BtnNotes" Content="Заметки" Margin="10" Click="BtnNotes_Click"/>
            <Button x:Name="BtnCalc" Content="Калькулятор" Margin="10" Click="BtnCalc_Click"/>
            <Button x:Name="BtnAbout" Content="О программе" Margin="10" Click="BtnAbout_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>